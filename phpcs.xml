<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="drupal_core">
  <description>Default PHP CodeSniffer configuration for Drupal core.</description>
  <file>.</file>
  <arg name="extensions" value="inc,info,install,module,php,profile,test,theme,js,twig,yml"/>

  <!--Exclude third party code.-->
  <exclude-pattern>./vendor/*</exclude-pattern>
  <exclude-pattern>*.md</exclude-pattern>
  <exclude-pattern>*.css</exclude-pattern>
  <exclude-pattern>*.js</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>assets/*</exclude-pattern>
  <exclude-pattern>gulpfile.js</exclude-pattern>

  <rule ref="Drupal" />
  <rule ref="DrupalPractice" />

  <!-- Twig is not PHP. <?xml in templates is an XML declaration, not a short open tag. -->
  <rule ref="Generic.PHP.DisallowShortOpenTag">
    <exclude-pattern>*.twig</exclude-pattern>
  </rule>
</ruleset>
