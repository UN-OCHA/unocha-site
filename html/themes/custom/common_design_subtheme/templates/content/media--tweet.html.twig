{#
/**
 * @file
 * Theme override to present a tweet media entity.
 *
 * Same as media.html.twig but attaching the library to display tweets as
 * proper blocks (not floated and responsive).
 *
 * @see media.html.twig
 */
#}
{%
  set classes = [
    'media',
    'media--type-tweet',
    view_mode ? 'media--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('common_design_subtheme/uno-tweet') }}
<article{{ attributes.addClass(classes) }}>
  {{ title_suffix.contextual_links }}
  {% if content %}
    {{ content }}
  {% endif %}
</article>
