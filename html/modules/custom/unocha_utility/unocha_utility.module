<?php

/**
 * @file
 * Helper functions that applies to a variety of things on UNOCHA.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Template\Attribute;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess().
 *
 * Ensure the attributes and *_attributes are set for the unocha templates.
 */
function unocha_utility_preprocess(array &$variables, $hook) {
  if (strpos($hook, 'unocha_') === 0) {
    foreach ($variables as $key => $value) {
      if ($key === 'attributes' || strpos($key, '_attributes') !== FALSE) {
        if (is_null($value)) {
          $variables[$key] = new Attribute();
        }
      }
    }
  }
}

/**
 * Helper to load the configured 404 node if available.
 *
 * @return \Drupal\node\NodeInterface|false
 *   The 404 node if found, FALSE otherwise.
 */
function unocha_utility_get_404_node(): NodeInterface|false {
  static $node;

  if (!isset($node)) {
    $node = FALSE;

    // Only act on actual 404 responses.
    $exception = \Drupal::request()->attributes->get('exception');
    if (!$exception || $exception->getStatusCode() !== 404) {
      return FALSE;
    }

    // Check if there is a custom 404 page configured.
    $path_404 = \Drupal::config('system.site')->get('page.404');
    if (!$path_404) {
      return FALSE;
    }

    // Try to match the path to a node.
    try {
      $params = \Drupal::service('router')->match($path_404);
    }
    catch (\Exception) {
      return FALSE;
    }

    // Check if the node is a valid node.
    if (!isset($params['node']) || !$params['node'] instanceof NodeInterface) {
      return FALSE;
    }

    // Cache the node.
    $node = $params['node'];
  }

  return $node;
}

/**
 * Implements hook_metatags_alter().
 */
function unocha_utility_metatags_alter(array &$metatags, array &$context): void {
  // Check if we are on the custom 404 page.
  $node = unocha_utility_get_404_node();
  if (!$node) {
    return;
  }

  // No metatags for 404 pages. This notably prevents leaking the original
  // entity's metatags into the 404 page. For example, the `current-page` tokens
  // resolve againt the current request but the 404 node is loaded in a
  // subrequest.
  $metatags = [];

  // Just in case, ensure the 404 node is the entity in the context.
  $context['entity'] = $node;
}

/**
 * Implements hook_preprocess_page_title().
 */
function unocha_utility_preprocess_page_title(array &$variables): void {
  // Check if we are on the custom 404 page.
  $node = unocha_utility_get_404_node();
  if (!$node) {
    return;
  }

  // Replace the title with the 404 node's title instead of the current page's
  // title which comes from the original request.
  $variables['title'] = $node->getTitle();
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for 'node_form'.
 *
 * Show the children menu title override only when the "Children Menu"
 * checkbox is enabled.
 */
function unocha_utility_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'basic') {
    return;
  }

  if (isset($form['field_children_menu_title'])) {
    $form['field_children_menu_title']['#states'] = [
      'visible' => [
        ':input[name="field_children_menu[value]"]' => ['checked' => TRUE],
      ],
    ];
  }
}

/**
 * Check whether the current request is in an editing (form) context.
 *
 * This covers the CKEditor media preview, the layout paragraphs builder and
 * the administrative pages (node forms, paragraph previews in forms, etc.).
 *
 * @return bool
 *   TRUE if the current request is an editing context.
 */
function unocha_utility_is_editing_context(): bool {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (empty($route_name)) {
    return FALSE;
  }

  if ($route_name === 'media.filter.preview' || str_starts_with($route_name, 'layout_paragraphs.builder.')) {
    return TRUE;
  }

  return \Drupal::service('router.admin_context')->isAdminRoute();
}

/**
 * Implements hook_media_build_defaults_alter().
 *
 * Tweets embedded in text via CKEditor vary depending on whether they are
 * displayed in an editing context or on the actual page, so make sure the
 * render cache varies by route.
 */
function unocha_utility_media_build_defaults_alter(array &$build, EntityInterface $entity, $view_mode): void {
  if ($entity->bundle() === 'tweet') {
    $build['#cache']['contexts'][] = 'route.name';
  }
}

/**
 * Implements hook_media_view_mode_alter().
 *
 * Use the "preview" view mode for tweets in editing contexts (CKEditor preview,
 * paragraph previews, forms) and the "default" view mode on the actual pages.
 */
function unocha_utility_media_view_mode_alter(string &$view_mode, EntityInterface $entity): void {
  if ($view_mode === 'default' && $entity->bundle() === 'tweet' && unocha_utility_is_editing_context()) {
    $view_mode = 'preview';
  }
}

/**
 * Implements hook_preprocess_media().
 *
 * Add the media type and view mode classes to the media wrapper so that they
 * are available whatever the theme rendering the media. This is notably needed
 * for the CKEditor media previews which are rendered with the default theme
 * but displayed in the administration theme.
 */
function unocha_utility_preprocess_media(array &$variables): void {
  if (!isset($variables['media'])) {
    return;
  }
  $variables['attributes']['class'][] = 'media';
  $variables['attributes']['class'][] = 'media--type-' . str_replace('_', '-', $variables['media']->bundle());
  if (!empty($variables['view_mode'])) {
    $variables['attributes']['class'][] = 'media--view-mode-' . str_replace('_', '-', $variables['view_mode']);
  }

  // Extract the information used by the tweet placeholder preview.
  if ($variables['media']->bundle() === 'tweet' && $variables['media']->hasField('field_media_twitter')) {
    $url = (string) $variables['media']->get('field_media_twitter')->value;
    $variables['tweet_url'] = $url;
    $variables['tweet_handle'] = NULL;
    if (preg_match('~(?:twitter|x)\.com/([^/?#]+)/status/~i', $url, $matches)) {
      $variables['tweet_handle'] = $matches[1];
    }
  }
}

/**
 * Implements hook_theme().
 */
function unocha_utility_theme(): array {
  return [
    // Placeholder preview of a tweet embed in editing contexts. The template is
    // used for the "preview" view mode of the "tweet" media type.
    'media__tweet__preview' => [
      'base hook' => 'media',
    ],
  ];
}
